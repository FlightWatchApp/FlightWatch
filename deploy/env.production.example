# SPEC-042 — modelo do deploy/.env.production (copie, preencha e `chmod 600`).
# NUNCA faça commit do arquivo preenchido (o .gitignore já o ignora).
# Gere cada segredo com:   openssl rand -base64 36 | tr -d '/+=' | cut -c1-40

# --- Endereço público ---------------------------------------------------------
WEB_BASE_URL=https://flightwatch.com.br

# --- Segredos internos (gere um para cada) -----------------------------------
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# BFF → API (SPEC-025): mínimo 32 caracteres.
INTERNAL_API_SECRET=

# --- Fonte de preços (ADR-008, SPEC-030) --------------------------------------
FLIGHT_PROVIDER=travelpayouts
TRAVELPAYOUTS_TOKEN=
# Marker de afiliado (SPEC-020): troque 000000 pelo seu.
AFFILIATE_TRACKING_PARAMS={"TRAVELPAYOUTS":{"marker":"000000"}}

# --- E-mail (SPEC-036) --------------------------------------------------------
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=Flight Watch <avisos@avisos.flightwatch.com.br>

# --- Captcha (SPEC-041): painel da Cloudflare → Turnstile ---------------------
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# --- Acesso por convite (SPEC-043): false = qualquer pessoa cria conta ---------
INVITE_REQUIRED=true
INVITE_TTL_DAYS=30
MONTHLY_WATCH_LIMIT=5

# --- Promoções, vitrine e página da rota (SPEC-032/033/034) -------------------
PROMOTION_ENGINE_ENABLED=true
PROMOTION_SHOWCASE_ORIGIN_CITIES=SAO,RIO,BSB,BHZ,POA,CWB,SSA,REC,FOR,CGR
ROUTE_PAGE_ENABLED=true
ROUTE_SITEMAP_ORIGIN_CITIES=SAO,RIO,BSB,BHZ,POA,CWB,SSA,REC,FOR
# Orçamentos diários de chamadas à fonte (ajuste com o uso real).
PROMOTION_DAILY_CALL_BUDGET=2000
ROUTE_PAGE_DAILY_CALL_BUDGET=1000

# --- Ritmo das consultas do price-worker (SPEC-042 §Frequência) -------------------
# A Travelpayouts bloqueia o token pelo resto do minuto acima de 300/min, e a API
# usa o mesmo token. 2/s (120/min) deixa folga para a API e ainda cobre ~28 mil
# monitoramentos verificados a cada 4 h.
PRICE_WORKER_RATE_LIMIT_PER_SECOND=2
PRICE_WORKER_RATE_LIMIT_CAPACITY=5

# --- Logs -------------------------------------------------------------------------
LOG_LEVEL=info

# --- Cloudflare Tunnel: painel da Cloudflare → Zero Trust → Networks → Tunnels --
CLOUDFLARE_TUNNEL_TOKEN=

# --- Estatística do beta (Umami, SPEC-042) ------------------------------------
UMAMI_DB_PASSWORD=
UMAMI_APP_SECRET=
# Preencha depois de criar o site no painel do Umami (stats.flightwatch.com.br)
# e rode deploy/bin/update.sh de novo. Vazio = nenhum script de estatística.
UMAMI_WEBSITE_ID=

# --- Backup (bin/backup.sh) -----------------------------------------------------
# Senha que criptografa os backups. Guarde também FORA do servidor: sem ela,
# nenhum backup abre.
BACKUP_PASSPHRASE=
# Opcional: destino do rclone para a cópia fora do servidor (ex.: gdrive:flightwatch).
BACKUP_RCLONE_REMOTE=
