{
  "name": "@flight-watch/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "nodemon --watch src --ext ts --exec \"pnpm build && node dist/main.js\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@flight-watch/config": "workspace:*",
    "@flight-watch/contracts": "workspace:*",
    "@flight-watch/database": "workspace:*",
    "@flight-watch/domain": "workspace:*",
    "@flight-watch/notifications": "workspace:*",
    "@flight-watch/observability": "workspace:*",
    "@flight-watch/providers": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-fastify": "^10.4.15",
    "@nestjs/throttler": "^6.7.0",
    "@node-rs/argon2": "^2.2.1",
    "fastify": "^4.28.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.15",
    "@swc/core": "^1.7.42",
    "@testcontainers/postgresql": "^10.13.2",
    "@types/node": "^22.9.0",
    "@types/supertest": "^6.0.2",
    "nodemon": "^3.1.7",
    "supertest": "^7.0.0",
    "typescript": "^5.7.2",
    "unplugin-swc": "^1.5.1",
    "vitest": "^2.1.4"
  }
}
