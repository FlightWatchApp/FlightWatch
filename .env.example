# Flight Watch — variáveis de ambiente (SPEC-024)
#
# Fonte de verdade: packages/config/src/processes.ts. Um teste falha se este
# arquivo e os schemas divergirem. Nunca coloque segredo real aqui.
#
# Linhas comentadas (# CHAVE=valor) são opcionais e mostram o padrão.
# Em APP_ENV development/test, DATABASE_URL, REDIS_URL e WEB_BASE_URL já
# apontam para o docker compose local; em staging/production são obrigatórias.

# --- Ambiente -----------------------------------------------------------------
# development | test | production
NODE_ENV=development
# development | test | staging | production — obrigatória com NODE_ENV=production.
# Com production, FLIGHT_PROVIDER/EMAIL_PROVIDER "simulated" impedem o startup.
APP_ENV=development

# --- Infraestrutura (todos os processos de backend) ---------------------------
DATABASE_URL=postgresql://flight_watch:flight_watch@localhost:5432/flight_watch
# scheduler, workers e API (cache de promoções e calendário, SPEC-032)
REDIS_URL=redis://localhost:6379

# Métricas Prometheus em listener interno, nunca na porta pública.
# METRICS_PORT padrão por processo: api 9100, scheduler 9101, price-worker 9102,
# alert-worker 9103, notification-worker 9104. Defina por processo no deploy.
# METRICS_HOST=127.0.0.1
# METRICS_PORT=9100

# URL pública do web: links de confirmação de e-mail (api) e de alertas
# (notification-worker). Também usada pelo apps/web para metadados.
WEB_BASE_URL=http://localhost:3100

# Segredo compartilhado entre web e API (SPEC-025): autentica o IP do cliente
# que o web repassa à API para o rate limit. Mínimo de 32 caracteres; em
# development/test o padrão local é usado se vazio. Em staging/production é
# obrigatório e diferente do padrão — gere com: openssl rand -base64 48
# INTERNAL_API_SECRET=

# --- Adapters externos --------------------------------------------------------
# FLIGHT_PROVIDER: simulated | travelpayouts (ADR-008, SPEC-030).
FLIGHT_PROVIDER=simulated
# Obrigatório com FLIGHT_PROVIDER=travelpayouts (api e price-worker). Segredo:
# nunca em commit; gere/rotacione no painel da Travelpayouts.
# TRAVELPAYOUTS_TOKEN=
# FLIGHT_PROVIDER_TIMEOUT_MS=10000
# EMAIL_PROVIDER: hoje só simulated (adapter real depende do domínio).
EMAIL_PROVIDER=simulated

# --- API ----------------------------------------------------------------------
# PORT=3000
# Rate limit de POST /v1/searches/flights, por IP do cliente (SPEC-014/025).
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=10
# Rate limit das rotas de autenticação, por rota e por IP do cliente (SPEC-025).
# AUTH_RATE_LIMIT_WINDOW_MS=600000
# AUTH_RATE_LIMIT_MAX=20
# Parâmetros de afiliado por provider, JSON (SPEC-020). Inválido = ignorado e logado.
# AFFILIATE_TRACKING_PARAMS={"TRAVELPAYOUTS":{"marker":"123456"}}
# Promoções por origem (SPEC-032), calculadas sob demanda e guardadas só no
# Redis. Kill switch: false responde lista vazia sem chamar a fonte.
# PROMOTION_ENGINE_ENABLED=false
# PROMOTION_CANDIDATES_PER_ORIGIN=10
# PROMOTION_MIN_REFERENCE_POINTS=8
# Descontos em pontos-base (1500 = 15%). A partir do limite de suspeita, nunca no feed.
# PROMOTION_MIN_DOMESTIC_DISCOUNT_BPS=1500
# PROMOTION_MIN_INTERNATIONAL_DISCOUNT_BPS=2000
# PROMOTION_SUSPECT_DISCOUNT_BPS=7000
# Economia (unidade mínima) em que o componente do score satura: 100000 = R$ 1.000.
# PROMOTION_SAVING_SCORE_CAP_MINOR=100000
# PROMOTION_FEED_CACHE_TTL_MINUTES=360
# Cache por rota e mês, compartilhado com o calendário da busca (SPEC-031).
# PRICE_CALENDAR_CACHE_TTL_MINUTES=360
# Chamadas à fonte por dia UTC só para o feed (busca e monitoramento não contam).
# PROMOTION_DAILY_CALL_BUDGET=2000
# SPEC-033 — página da rota. Kill switch: false responde 404 (rota, sitemap e links).
# ROUTE_PAGE_ENABLED=false
# Chamadas à fonte por dia UTC só para a página (robôs de busca não consomem a cota do feed).
# ROUTE_PAGE_DAILY_CALL_BUDGET=1000
# ROUTE_PAGE_CACHE_TTL_MINUTES=30
# Meses de preço mostrados a partir do atual.
# ROUTE_PAGE_MONTHS=3
# Requisições por IP na janela de RATE_LIMIT_WINDOW_MS (a busca continua com RATE_LIMIT_MAX).
# ROUTE_PAGE_RATE_LIMIT_MAX=60
# Cidades de origem do sitemap (códigos de cidade, vírgula). Vazio: sitemap sem rotas.
# ROUTE_SITEMAP_ORIGIN_CITIES=SAO,RIO,BSB,BHZ,POA,CWB,SSA,REC,FOR
# ROUTE_SITEMAP_TTL_MINUTES=360

# --- Scheduler ----------------------------------------------------------------
# SCHEDULER_TICK_INTERVAL_MS=5000

# --- Price worker -------------------------------------------------------------
# PRICE_WORKER_CONCURRENCY=5
# PRICE_WORKER_RATE_LIMIT_CAPACITY=10
# PRICE_WORKER_RATE_LIMIT_PER_SECOND=5
# PRICE_WORKER_CIRCUIT_FAILURE_THRESHOLD=5
# PRICE_WORKER_CIRCUIT_RESET_TIMEOUT_MS=30000

# --- Alert worker -------------------------------------------------------------
# ALERT_WORKER_CONCURRENCY=5

# --- Notification worker ------------------------------------------------------
# NOTIFICATION_WORKER_CONCURRENCY=5
# NOTIFICATION_STALE_SENDING_THRESHOLD_MS=300000
# NOTIFICATION_STALE_SENDING_SWEEP_INTERVAL_MS=60000

# --- Web (apps/web) -----------------------------------------------------------
# URL interna da API, chamada só pelo servidor Next (BFF).
API_BASE_URL=http://localhost:3000
